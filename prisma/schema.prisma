// Zuper CBR Generator — Phase 1 schema
// Single-user internal tool: no User model, auth is a shared-password cookie gate (see src/lib/auth.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  zuperAccountId String
  // Customer's own company website — best-effort scraped for business context
  // (industry, services, size cues) to ground AI-generated recommendations.
  // Never a source of numbers, only tone/framing (see lib/website.ts).
  website        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  credential        ApiCredential?
  syncRuns          SyncRun[]
  jobs              Job[]
  jobLineItems      JobLineItem[]
  invoices          Invoice[]
  technicians       Technician[]
  payments          Payment[]
  quotes            Quote[]
  products          Product[]
  expenses          Expense[]
  timesheetEvents   TimesheetEvent[]
  endCustomers      EndCustomerLedger[]
  organizations     Organization[]
  properties        Property[]
  projects          Project[]
  workflows         Workflow[]
  executionSnapshots WorkflowExecutionSnapshot[]
  metricSnapshots   MetricSnapshot[]
  healthScores      HealthScore[]
  opportunities     OpportunitySignal[]
  reports           Report[]
}

// Discovered connection config only — the Zuper API key itself is NEVER stored.
// It's entered by hand for each sync and lives only in that request's memory.
model ApiCredential {
  id               String    @id @default(cuid())
  customerId       String    @unique
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  baseUrl          String    @default("https://api.zuperpro.com")
  // Workflow Builder lives on a separate host (dc_workflow_builder_url from the
  // accounts.zuperpro.com/api/config discovery response) — not derivable from baseUrl.
  workflowBaseUrl  String?
  lastVerifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Workflow Builder definitions. The API only exposes definitions plus the most
// recent run (last_execution_time/status) — no run counts, execution history or
// success rates. Re-confirmed 2026-09-23 across 3 accounts / 31 workflows: every
// runs/executions/history/logs/stats/analytics/usage path 404s, on both the
// Workflow Builder host and the main API. Trigger/step fields come from
// GET /workflows/{uid} (the published "live_nodes", else draft "nodes").
model Workflow {
  id                  String    @id @default(cuid())
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperWorkflowId     String
  name                String
  description         String?
  isActive            Boolean   @default(true)
  isAiGenerated       Boolean   @default(false)
  isPublished         Boolean   @default(false) // has a live_version; drafts never run
  lastPublishedAt     DateTime?
  needsAttention      Boolean   @default(false)
  triggerName         String? // e.g. "On Job Status Update", "On Webhook"
  triggerKey          String? // e.g. "job.status_update", "external_webhook"
  triggerModule       String? // JOB | PROJECT | null (webhook)
  stepCount           Int       @default(0) // ACTION nodes, excluding the trigger
  actionKeys          String[] // one entry per ACTION node, e.g. zuper_email, http_request
  lastExecutionStatus String? // COMPLETED | ... — the most recent run only
  lastExecutionTime   DateTime?
  createdAt          DateTime
  updatedAt          DateTime
  syncRunId          String

  @@unique([customerId, zuperWorkflowId])
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model SyncRun {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  modules      String[]
  status       SyncStatus @default(PENDING)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@index([customerId, createdAt])
}

model Job {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperJobId     String
  status         String // coarse bucket used by existing metrics: completed | cancelled | in_progress | open
  rawStatusName  String? // Zuper's actual status label, e.g. "Waiting on Parts", "Travel Time"
  serviceType    String?
  location       String?
  technicianId   String?
  endCustomerId  String? // Zuper's own customer_uid — the tenant's end customer, joins to EndCustomerLedger
  jobValue       Decimal?  @db.Decimal(12, 2)
  createdAt      DateTime
  completedAt    DateTime?
  scheduledAt    DateTime?
  priority       String? // LOW | MEDIUM | HIGH | URGENT
  isRecurring    Boolean   @default(false)
  isScheduled    Boolean   @default(false)
  currentStatusType String? // NEW | SCHEDULED | STARTED | COMPLETED | CLOSED | FOLLOW_UP | OTHER ...
  organizationUid String? // B2B accounts attach jobs to an organization rather than (or as well as) a customer
  // job_status[] history: [{ type, name, at (ISO), minutes }] — minutes = Zuper's time_on_status,
  // verified 2026-09-23 to equal the gap to the next status entry, in minutes.
  statusHistory  Json?
  syncRunId      String

  @@unique([customerId, zuperJobId])
  @@index([customerId, createdAt])
}

// Tenant's B2B organizations (GET /organization).
model Organization {
  id                  String   @id @default(cuid())
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperOrganizationId String
  name                String
  isActive            Boolean  @default(true)
  noOfCustomers       Int      @default(0)
  createdAt           DateTime
  syncRunId           String

  @@unique([customerId, zuperOrganizationId])
}

// Service locations (GET /property). noOfJobs is Zuper's own all-time count.
model Property {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperPropertyId String
  name            String
  organizationUid String?
  state           String?
  noOfJobs        Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime
  syncRunId       String

  @@unique([customerId, zuperPropertyId])
}

// GET /projects. Field mapping is best-effort — every account probed so far had
// zero projects, so a populated item's shape is unverified (same caveat as Expense).
model Project {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperProjectId String
  name           String
  status         String?
  createdAt      DateTime
  syncRunId      String

  @@unique([customerId, zuperProjectId])
}

// Aggregated Workflow Builder execution counts for one sync period, from the
// (undocumented) GET /workflows/execution_history endpoint that Workflow
// Builder's own Executions screen uses — verified 2026-09-23 to accept the API
// key and to return exact total_records per workflow/status/date filter.
// Zuper retains ~2 months of history, so retainedFrom is stored and shown.
model WorkflowExecutionSnapshot {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  retainedFrom  DateTime? // oldest execution Zuper still holds
  countedFrom   DateTime // max(periodStart, retainedFrom) — what the counts actually cover
  completed     Int       @default(0)
  failed        Int       @default(0)
  skipped       Int       @default(0)
  medianMs      Float?
  p90Ms         Float?
  // [{ workflowUid, name, completed, failed, skipped, medianMs }]
  perWorkflow   Json
  // [{ weekStart (ISO date), total, failed }]
  weekly        Json
  // [{ message, count }] from a sample of FAILED executions (see sampleSize)
  topErrors     Json
  errorSampleSize Int     @default(0)
  syncRunId     String
  createdAt     DateTime  @default(now())

  @@unique([customerId, periodStart, periodEnd])
}

// Parts/products/services actually added to a job — the job's own `products`
// array, which GET /jobs already returns inline (verified identical to
// GET /jobs/{uid} across 60 jobs, 2026-09-23). Unlike Product (the catalog),
// this is usage. Replaced wholesale per job on every sync; the list payload
// has no stable line-item uid, so rows are keyed by position within the job.
model JobLineItem {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperJobId    String
  position      Int
  productUid    String?
  name          String
  productType   String // PARTS | PRODUCT | SERVICE, as Zuper sends it (uppercased)
  category      String?
  quantity      Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice     Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  purchasePrice Decimal  @default(0) @db.Decimal(12, 2)
  jobCreatedAt  DateTime // denormalized from Job.createdAt so period filtering needs no join
  syncRunId     String

  @@unique([customerId, zuperJobId, position])
  @@index([customerId, jobCreatedAt])
}

model Invoice {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperInvoiceId String
  invoiceNo      Int?
  status         String
  amount         Decimal   @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(12, 2)
  isPaid         Boolean   @default(false)
  issuedAt       DateTime
  dueAt          DateTime?
  paidAt         DateTime?
  syncRunId      String

  @@unique([customerId, zuperInvoiceId])
  @@index([customerId, issuedAt])
}

// Zuper calls these "estimates" in the API; the product surfaces them as Quotes/Proposals.
model Quote {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperQuoteId String
  quoteNo      Int?
  status       String // DRAFT | SENT | APPROVED | REJECTED | EXPIRED | ...
  value        Decimal   @db.Decimal(12, 2)
  discount     Decimal   @default(0) @db.Decimal(12, 2)
  isConverted  Boolean   @default(false)
  isExpired    Boolean   @default(false)
  estimateAt   DateTime
  expiryAt     DateTime?
  sentAt       DateTime?
  acceptedAt   DateTime?
  convertedAt  DateTime?
  syncRunId    String

  @@unique([customerId, zuperQuoteId])
  @@index([customerId, estimateAt])
}

model Technician {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperUserId    String
  name           String
  email          String?
  designation    String? // Technician | Admin | Dispatch | Team Leader | ...
  hourlyRate     Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  licenseType    String? // PREMIUM | ... — from Zuper's own /team user record
  lastLoginAt    DateTime? // seat-utilization signal: licensed but not logging in = renewal risk
  jobsCompleted  Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(12, 2)
  completionRate Decimal  @default(0) @db.Decimal(5, 4)
  avgJobValue    Decimal  @default(0) @db.Decimal(12, 2)
  hoursWorked    Decimal  @default(0) @db.Decimal(10, 2)
  rating         Decimal? @db.Decimal(3, 2)
  periodStart    DateTime
  periodEnd      DateTime
  syncRunId      String

  @@unique([customerId, zuperUserId, periodStart, periodEnd])
}

model Payment {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperPaymentId   String
  amount           Decimal  @db.Decimal(12, 2)
  currency         String?
  paymentModeName  String? // "Check" | "Credit Card" | ...
  paymentModeType  String? // "ONLINE" | "OFFLINE" — used as a Zuper Pay / digital-payment proxy
  actionModule     String? // "INVOICE" | ...
  status           String? // "SUCCESS" | ...
  zuperInvoiceId   String?
  zuperPayUsed     Boolean  @default(false)
  paidAt           DateTime
  syncRunId        String

  @@unique([customerId, zuperPaymentId])
  @@index([customerId, paidAt])
}

// Zuper's master product/parts catalog with current stock and pricing —
// used for inventory-value and low-stock metrics, not job-level parts usage.
model Product {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperProductId  String
  sku             String?
  name            String
  category        String?
  price           Decimal  @default(0) @db.Decimal(12, 2)
  purchasePrice   Decimal  @default(0) @db.Decimal(12, 2)
  quantity        Decimal  @default(0) @db.Decimal(12, 2)
  minQuantity     Decimal  @default(0) @db.Decimal(12, 2)
  lowStock        Boolean  @default(false)
  isBillable      Boolean  @default(true)
  syncRunId       String

  @@unique([customerId, zuperProductId])
}

// Field shape is unverified against a populated account — see zuper/modules.ts.
model Expense {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperExpenseId String
  amount         Decimal   @db.Decimal(12, 2)
  isBillable     Boolean   @default(false)
  category       String?
  description    String?
  incurredAt     DateTime
  syncRunId      String

  @@unique([customerId, zuperExpenseId])
  @@index([customerId, incurredAt])
}

// Raw clock-in/out events from /timesheets. Hours worked are derived by
// pairing CHECK_IN/CHECK_OUT events per technician (see analytics.ts).
model TimesheetEvent {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperTimesheetId  String
  zuperUserId       String
  userName          String?
  typeOfCheck       String // CHECK_IN | CHECK_OUT
  checkedAt         DateTime
  syncRunId         String

  @@unique([customerId, zuperTimesheetId])
  @@index([customerId, zuperUserId, checkedAt])
}

// Zuper's own end-customer ledger (accounts.ltv/receivables/credits) —
// pulled straight from /customers rather than re-derived, refreshed each sync.
model EndCustomerLedger {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zuperCustomerId String
  name            String
  isActive        Boolean  @default(true)
  noOfJobs        Int      @default(0)
  ltv             Decimal  @default(0) @db.Decimal(12, 2)
  receivables     Decimal  @default(0) @db.Decimal(12, 2)
  credits         Decimal  @default(0) @db.Decimal(12, 2)
  tags            String[]
  category        String? // customer_category.category_name, e.g. "Retail"
  organizationUid String?
  createdInZuperAt DateTime? // when the end customer was created in Zuper — "new customers this period"
  syncRunId       String

  @@unique([customerId, zuperCustomerId])
}

model MetricSnapshot {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  metricKey        String
  value            Decimal  @db.Decimal(14, 2)
  comparisonPeriod String?
  comparisonValue  Decimal? @db.Decimal(14, 2)
  changePct        Decimal? @db.Decimal(7, 4)
  createdAt        DateTime @default(now())

  @@index([customerId, periodStart, periodEnd, metricKey])
}

model HealthScore {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reportId        String?
  overallScore    Int
  dimensionScores Json
  createdAt       DateTime @default(now())
}

model OpportunitySignal {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reportId   String?
  type       String
  score      String
  evidence   Json
  narrative  String?
  createdAt  DateTime @default(now())
}

enum ReportType {
  QBR
  MBR
  HBR
}

enum ReportStatus {
  DRAFT
  FINAL
}

model ReportTemplate {
  id        String     @id @default(cuid())
  name      String
  type      ReportType
  sections  Json
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  reports Report[]
}

model Report {
  id          String       @id @default(cuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  templateId  String
  template    ReportTemplate @relation(fields: [templateId], references: [id])
  type        ReportType
  periodStart DateTime
  periodEnd   DateTime
  compareMode String? // "previous_period" | "yoy" | "none"
  status      ReportStatus @default(DRAFT)
  shareToken  String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sections ReportSection[]
}

model ReportSection {
  id                  String   @id @default(cuid())
  reportId            String
  report              Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sectionKey          String
  order                Int
  contentJson         Json
  narrativeText       String?
  recommendationText  String?
  isEdited            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([reportId, sectionKey])
}
